{
  "provider": "zoho_bigin",
  "auth_type": "oauth2",
  "base_url": "https://www.zohoapis.com/bigin/",
  "category": "crm",
  "stub": false,
  "actions": [
    {
      "name": "get-contact",
      "description": "Get a specific contact by ID.",
      "http_method": "GET",
      "endpoint": "contacts/{contact_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "contact_id": {
            "type": "string",
            "description": "The ID of the contact to retrieve."
          }
        },
        "required": [
          "contact_id"
        ]
      }
    },
    {
      "name": "list-contacts",
      "description": "List all contacts.",
      "http_method": "GET",
      "endpoint": "contacts",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Page number for pagination."
          },
          "per_page": {
            "type": "integer",
            "description": "Number of contacts per page."
          }
        },
        "required": []
      }
    },
    {
      "name": "create-contact",
      "description": "Create a new contact.",
      "http_method": "POST",
      "endpoint": "contacts",
      "input_schema": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "description": "The first name of the contact."
          },
          "last_name": {
            "type": "string",
            "description": "The last name of the contact."
          },
          "email": {
            "type": "string",
            "description": "The email address of the contact."
          },
          "phone": {
            "type": "string",
            "description": "The phone number of the contact."
          }
        },
        "required": [
          "first_name",
          "last_name"
        ]
      }
    },
    {
      "name": "update-contact",
      "description": "Update an existing contact.",
      "http_method": "PUT",
      "endpoint": "contacts/{contact_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "contact_id": {
            "type": "string",
            "description": "The ID of the contact to update."
          },
          "first_name": {
            "type": "string",
            "description": "The first name of the contact."
          },
          "last_name": {
            "type": "string",
            "description": "The last name of the contact."
          },
          "email": {
            "type": "string",
            "description": "The email address of the contact."
          },
          "phone": {
            "type": "string",
            "description": "The phone number of the contact."
          }
        },
        "required": [
          "contact_id"
        ]
      }
    },
    {
      "name": "delete-contact",
      "description": "Delete a contact.",
      "http_method": "DELETE",
      "endpoint": "contacts/{contact_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "contact_id": {
            "type": "string",
            "description": "The ID of the contact to delete."
          }
        },
        "required": [
          "contact_id"
        ]
      }
    },
    {
      "name": "get-deal",
      "description": "Get a specific deal by ID.",
      "http_method": "GET",
      "endpoint": "deals/{deal_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "deal_id": {
            "type": "string",
            "description": "The ID of the deal to retrieve."
          }
        },
        "required": [
          "deal_id"
        ]
      }
    },
    {
      "name": "list-deals",
      "description": "List all deals.",
      "http_method": "GET",
      "endpoint": "deals",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Page number for pagination."
          },
          "per_page": {
            "type": "integer",
            "description": "Number of deals per page."
          }
        },
        "required": []
      }
    },
    {
      "name": "create-deal",
      "description": "Create a new deal.",
      "http_method": "POST",
      "endpoint": "deals",
      "input_schema": {
        "type": "object",
        "properties": {
          "deal_name": {
            "type": "string",
            "description": "The name of the deal."
          },
          "amount": {
            "type": "number",
            "description": "The amount of the deal."
          }
        },
        "required": [
          "deal_name",
          "amount"
        ]
      }
    }
  ],
  "syncs": [
    {
      "name": "contacts",
      "description": "Sync all contacts.",
      "entity": "Contacts",
      "frequency": "daily"
    },
    {
      "name": "deals",
      "description": "Sync all deals.",
      "entity": "Deals",
      "frequency": "daily"
    }
  ],
  "provider_config": {
    "display_name": "Zoho Bigin",
    "authorization_url": "https://accounts.zoho.com/oauth/v2/auth",
    "token_url": "https://accounts.zoho.com/oauth/v2/token",
    "revocation_url": "https://accounts.zoho.com/oauth/v2/token/revoke",
    "disable_pkce": false,
    "default_scopes": "Bigin.full_access",
    "docs": "https://www.zoho.com/bigin/api/docs/",
    "setup_guide_url": "https://www.zoho.com/bigin/help/api/getting-started.html",
    "webhook_routing_script": null,
    "post_connection_script": null,
    "proxy": {
      "base_url": "https://www.zohoapis.com/bigin/",
      "headers": {
        "authorization": "Bearer ${accessToken}"
      },
      "paginate": {
        "type": "link"
      },
      "retry": {
        "at": [
          "x-ratelimit-reset"
        ],
        "error_code": [
          "401",
          "403",
          "429",
          "5xx"
        ]
      }
    }
  },
  "executor": "generic_http",
  "skill_source": {
    "composio_skill_folder": "zoho_bigin-automation",
    "display_name": "zoho_bigin-automation",
    "description": "Automate Zoho Bigin tasks via Rube MCP (Composio): pipelines, contacts, companies, products, and small business CRM. Always search tools first for current schemas.",
    "toolkit_slug": "zoho_bigin",
    "composio_tool_slugs": [],
    "tool_slugs_hint": [
      "ACTIVE",
      "CRM"
    ]
  }
}
