{
  "provider": "wave_accounting",
  "auth_type": "oauth2",
  "base_url": "https://api.waveapps.com",
  "category": "accounting",
  "stub": false,
  "actions": [
    {
      "name": "get-user",
      "description": "Get the current user's information.",
      "http_method": "GET",
      "endpoint": "/users/me",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "list-invoices",
      "description": "List all invoices.",
      "http_method": "GET",
      "endpoint": "/invoices",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Page number for pagination."
          },
          "per_page": {
            "type": "integer",
            "description": "Number of invoices per page."
          }
        },
        "required": []
      }
    },
    {
      "name": "get-invoice",
      "description": "Get a specific invoice by ID.",
      "http_method": "GET",
      "endpoint": "/invoices/{invoice_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "integer",
            "description": "The ID of the invoice."
          }
        },
        "required": [
          "invoice_id"
        ]
      }
    },
    {
      "name": "create-invoice",
      "description": "Create a new invoice.",
      "http_method": "POST",
      "endpoint": "/invoices",
      "input_schema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "integer",
            "description": "The ID of the customer."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "The invoice date."
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "description": "The invoice due date."
          }
        },
        "required": [
          "customer_id",
          "date"
        ]
      }
    },
    {
      "name": "update-invoice",
      "description": "Update an existing invoice.",
      "http_method": "PUT",
      "endpoint": "/invoices/{invoice_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "integer",
            "description": "The ID of the invoice."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "The invoice date."
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "description": "The invoice due date."
          }
        },
        "required": [
          "invoice_id"
        ]
      }
    },
    {
      "name": "delete-invoice",
      "description": "Delete an invoice.",
      "http_method": "DELETE",
      "endpoint": "/invoices/{invoice_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "integer",
            "description": "The ID of the invoice."
          }
        },
        "required": [
          "invoice_id"
        ]
      }
    },
    {
      "name": "list-customers",
      "description": "List all customers.",
      "http_method": "GET",
      "endpoint": "/customers",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Page number for pagination."
          },
          "per_page": {
            "type": "integer",
            "description": "Number of customers per page."
          }
        },
        "required": []
      }
    },
    {
      "name": "get-customer",
      "description": "Get a specific customer by ID.",
      "http_method": "GET",
      "endpoint": "/customers/{customer_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "integer",
            "description": "The ID of the customer."
          }
        },
        "required": [
          "customer_id"
        ]
      }
    },
    {
      "name": "create-customer",
      "description": "Create a new customer.",
      "http_method": "POST",
      "endpoint": "/customers",
      "input_schema": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "description": "The customer's first name."
          },
          "last_name": {
            "type": "string",
            "description": "The customer's last name."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "The customer's email address."
          }
        },
        "required": [
          "first_name",
          "last_name"
        ]
      }
    }
  ],
  "syncs": [
    {
      "name": "invoices",
      "description": "Sync all invoices.",
      "entity": "Invoice",
      "frequency": "daily"
    },
    {
      "name": "customers",
      "description": "Sync all customers.",
      "entity": "Customer",
      "frequency": "daily"
    }
  ],
  "provider_config": {
    "display_name": "Wave Accounting",
    "authorization_url": "https://foundry.waveapps.com/oauth/authorize",
    "token_url": "https://foundry.waveapps.com/oauth/token",
    "disable_pkce": false,
    "default_scopes": "offline_access,accounting.invoices,accounting.customers",
    "docs": "https://developer.waveapps.com/",
    "setup_guide_url": "https://developer.waveapps.com/docs/getting-started",
    "webhook_routing_script": null,
    "post_connection_script": null,
    "proxy": {
      "base_url": "https://api.waveapps.com",
      "headers": {
        "authorization": "Bearer ${accessToken}"
      },
      "paginate": {
        "type": "cursor"
      },
      "retry": {
        "at": [
          "x-ratelimit-reset"
        ],
        "error_code": [
          "401",
          "403",
          "429",
          "5xx"
        ]
      }
    }
  },
  "executor": "generic_http",
  "skill_source": {
    "composio_skill_folder": "wave_accounting-automation",
    "display_name": "wave_accounting-automation",
    "description": "Automate Wave Accounting tasks via Rube MCP (Composio): invoices, customers, payments, and small business accounting. Always search tools first for current schemas.",
    "toolkit_slug": "wave_accounting",
    "composio_tool_slugs": [],
    "tool_slugs_hint": [
      "ACTIVE"
    ]
  }
}
