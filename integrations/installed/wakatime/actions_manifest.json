{
  "provider": "wakatime",
  "auth_type": "api_key",
  "base_url": "https://api.wakatime.com/api/v1",
  "category": "developer_tools",
  "stub": false,
  "actions": [
    {
      "name": "get-user-stats",
      "description": "Get statistics for a specific user.",
      "http_method": "GET",
      "endpoint": "/users/{user_id}/stats",
      "input_schema": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "The user ID."
          }
        },
        "required": [
          "user_id"
        ]
      }
    },
    {
      "name": "get-project-stats",
      "description": "Get statistics for a specific project.",
      "http_method": "GET",
      "endpoint": "/projects/{project_id}/stats",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "The project ID."
          }
        },
        "required": [
          "project_id"
        ]
      }
    },
    {
      "name": "get-daily-stats",
      "description": "Get daily statistics for a user.",
      "http_method": "GET",
      "endpoint": "/users/{user_id}/stats/daily",
      "input_schema": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "The user ID."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "The date for which to retrieve statistics (YYYY-MM-DD)."
          }
        },
        "required": [
          "user_id",
          "date"
        ]
      }
    },
    {
      "name": "get-heartbeats",
      "description": "Get heartbeats for a user within a date range.",
      "http_method": "GET",
      "endpoint": "/users/{user_id}/heartbeats",
      "input_schema": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "The user ID."
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "The start date (YYYY-MM-DD)."
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "The end date (YYYY-MM-DD)."
          }
        },
        "required": [
          "user_id",
          "start_date",
          "end_date"
        ]
      }
    },
    {
      "name": "get-user-projects",
      "description": "Get a list of projects for a user.",
      "http_method": "GET",
      "endpoint": "/users/{user_id}/projects",
      "input_schema": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "The user ID."
          }
        },
        "required": [
          "user_id"
        ]
      }
    }
  ],
  "syncs": [
    {
      "name": "user_projects",
      "description": "Sync user projects.",
      "entity": "Project",
      "frequency": "daily"
    }
