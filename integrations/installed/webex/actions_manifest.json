{
  "provider": "webex",
  "auth_type": "oauth2",
  "base_url": "https://api.webex.com",
  "category": "collaboration",
  "stub": false,
  "actions": [
    {
      "name": "get-room",
      "description": "Get a specific room by ID.",
      "http_method": "GET",
      "endpoint": "/v1/rooms/{roomId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "description": "The ID of the room."
          }
        },
        "required": [
          "roomId"
        ]
      }
    },
    {
      "name": "list-rooms",
      "description": "List all rooms.",
      "http_method": "GET",
      "endpoint": "/v1/rooms",
      "input_schema": {
        "type": "object",
        "properties": {
          "max": {
            "type": "integer",
            "description": "Maximum number of rooms to return."
          }
        },
        "required": []
      }
    },
    {
      "name": "create-room",
      "description": "Create a new room.",
      "http_method": "POST",
      "endpoint": "/v1/rooms",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the room."
          }
        },
        "required": [
          "title"
        ]
      }
    },
    {
      "name": "delete-room",
      "description": "Delete a room.",
      "http_method": "DELETE",
      "endpoint": "/v1/rooms/{roomId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "description": "The ID of the room."
          }
        },
        "required": [
          "roomId"
        ]
      }
    },
    {
      "name": "send-message",
      "description": "Send a message to a room.",
      "http_method": "POST",
      "endpoint": "/v1/messages",
      "input_schema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "description": "The ID of the room."
          },
          "text": {
            "type": "string",
            "description": "The message text."
          }
        },
        "required": [
          "roomId",
          "text"
        ]
      }
    },
    {
      "name": "get-message",
      "description": "Get a specific message by ID.",
      "http_method": "GET",
      "endpoint": "/v1/messages/{messageId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "The ID of the message."
          }
        },
        "required": [
          "messageId"
        ]
      }
    },
    {
      "name": "list-messages",
      "description": "List messages in a room.",
      "http_method": "GET",
      "endpoint": "/v1/rooms/{roomId}/messages",
      "input_schema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "description": "The ID of the room."
          },
          "max": {
            "type": "integer",
            "description": "Maximum number of messages to return."
          }
        },
        "required": [
          "roomId"
        ]
      }
    },
    {
      "name": "get-user",
      "description": "Get a specific user by ID.",
      "http_method": "GET",
      "endpoint": "/v1/people/{personId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "personId": {
            "type": "string",
            "description": "The ID of the user."
          }
        },
        "required": [
          "personId"
        ]
      }
    },
    {
      "name": "list-users",
      "description": "List all users.",
      "http_method": "GET",
      "endpoint": "/v1/people",
      "input_schema": {
        "type": "object",
        "properties": {
          "max": {
            "type": "integer",
            "description": "Maximum number of users to return."
          }
        },
        "required": []
      }
    }
  ],
  "syncs": [
    {
      "name": "rooms",
      "description": "Sync all Webex rooms.",
      "entity": "Room",
      "frequency": "60m"
    },
    {
      "name": "users",
      "description": "Sync all Webex users.",
      "entity": "User",
      "frequency": "60m"
    }
  ],
  "provider_config": {
    "display_name": "Webex",
    "authorization_url": "https://webex.com/oauth2/authorize",
    "token_url": "https://webex.com/oauth2/token",
    "disable_pkce": false,
    "default_scopes": "spark:rooms_read,spark:rooms_write,spark:people_read,spark:messages_read,spark:messages_write",
    "docs": "https://developer.webex.com/docs",
    "setup_guide_url": "https://developer.webex.com/docs/getting-started",
    "webhook_routing_script": null,
    "post_connection_script": null,
    "proxy": {
      "base_url": "https://api.webex.com",
      "headers": {
        "authorization": "Bearer ${accessToken}"
      },
      "paginate": {
        "type": "link"
      },
      "retry": {
        "at": [
          "x-ratelimit-reset"
        ],
        "error_code": [
          "401",
          "403",
          "429",
          "5xx"
        ]
      }
    },
    "authorization_params": {
      "response_type": "code"
    },
    "scope_separator": " "
  },
  "executor": "generic_http",
  "skill_source": {
    "composio_skill_folder": "webex-automation",
    "display_name": "Webex Automation",
    "description": "Automate Cisco Webex messaging, rooms, teams, webhooks, and people management through natural language commands",
    "toolkit_slug": "webex",
    "composio_tool_slugs": [
      "WEBEX_LIST_TEAMS",
      "WEBEX_LIST_WEBHOOKS",
      "WEBEX_MESSAGING_CREATE_MESSAGE",
      "WEBEX_MESSAGING_CREATE_TEAM_MEMBERSHIP",
      "WEBEX_MESSAGING_DELETE_MESSAGE",
      "WEBEX_MESSAGING_GET_MESSAGE_DETAILS",
      "WEBEX_MESSAGING_GET_ROOM_DETAILS",
      "WEBEX_MESSAGING_LIST_MEMBERSHIPS",
      "WEBEX_MESSAGING_LIST_ROOMS",
      "WEBEX_PEOPLE_LIST_PEOPLE",
      "WEBEX_UPDATE_ROOM",
      "WEBEX_WEBHOOKS_CREATE_WEBHOOK",
      "WEBEX_WEBHOOKS_GET_WEBHOOK"
    ],
    "tool_slugs_hint": [
      "HMAC",
      "WEBEX_LIST_TEAMS",
      "WEBEX_LIST_WEBHOOKS",
      "WEBEX_MESSAGING_CREATE_MESSAGE",
      "WEBEX_MESSAGING_CREATE_TEAM_MEMBERSHIP",
      "WEBEX_MESSAGING_DELETE_MESSAGE",
      "WEBEX_MESSAGING_GET_MESSAGE_DETAILS",
      "WEBEX_MESSAGING_GET_ROOM_DETAILS",
      "WEBEX_MESSAGING_LIST_MEMBERSHIPS",
      "WEBEX_MESSAGING_LIST_ROOMS",
      "WEBEX_PEOPLE_LIST_PEOPLE",
      "WEBEX_UPDATE_ROOM",
      "WEBEX_WEBHOOKS_CREATE_WEBHOOK",
      "WEBEX_WEBHOOKS_GET_WEBHOOK"
    ]
  }
}
