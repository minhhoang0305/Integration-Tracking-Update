{
  "provider": "weathermap",
  "auth_type": "api_key",
  "base_url": "https://api.openweathermap.org/data/2.5",
  "category": "weather",
  "stub": false,
  "actions": [
    {
      "name": "get-current-weather",
      "description": "Get current weather data for a city.",
      "http_method": "GET",
      "endpoint": "/weather",
      "input_schema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "City name, e.g., London"
          },
          "units": {
            "type": "string",
            "description": "Units of measurement (metric, imperial)",
            "default": "metric"
          }
        },
        "required": [
          "q"
        ]
      }
    },
    {
      "name": "get-weather-forecast",
      "description": "Get 5-day/3-hour forecast data for a city.",
      "http_method": "GET",
      "endpoint": "/forecast",
      "input_schema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "City name, e.g., London"
          },
          "units": {
            "type": "string",
            "description": "Units of measurement (metric, imperial)",
            "default": "metric"
          }
        },
        "required": [
          "q"
        ]
      }
    },
    {
      "name": "get-weather-forecast-daily",
      "description": "Get daily forecast data for a city.",
      "http_method": "GET",
      "endpoint": "/forecast/daily",
      "input_schema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "City name, e.g., London"
          },
          "units": {
            "type": "string",
            "description": "Units of measurement (metric, imperial)",
            "default": "metric"
          }
        },
        "required": [
          "q"
        ]
      }
    },
    {
      "name": "get-weather-by-coordinates",
      "description": "Get current weather data by latitude and longitude.",
      "http_method": "GET",
      "endpoint": "/weather",
      "input_schema": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "description": "Latitude"
          },
          "lon": {
            "type": "number",
            "description": "Longitude"
          },
          "units": {
            "type": "string",
            "description": "Units of measurement (metric, imperial)",
            "default": "metric"
          }
        },
        "required": [
          "lat",
          "lon"
        ]
      }
    },
    {
      "name": "get-weather-forecast-by-coordinates",
