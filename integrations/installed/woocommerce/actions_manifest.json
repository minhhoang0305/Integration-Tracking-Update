{
  "provider": "woocommerce",
  "auth_type": "basic",
  "base_url": "https://{store_url}/wp-json/wc/v3",
  "category": "ecommerce",
  "stub": false,
  "actions": [
    {
      "name": "list-products",
      "description": "List all products in the WooCommerce store.",
      "http_method": "GET",
      "endpoint": "/products",
      "input_schema": {
        "type": "object",
        "properties": {
          "per_page": { "type": "integer", "description": "Number of products per page (max 100)", "default": 20 },
          "page": { "type": "integer", "description": "Page number" },
          "status": { "type": "string", "description": "Filter by status: publish, draft, pending" }
        },
        "required": []
      }
    },
    {
      "name": "get-product",
      "description": "Get details of a specific product.",
      "http_method": "GET",
      "endpoint": "/products/{id}",
      "input_schema": {
        "type": "object",
        "properties": { "id": { "type": "integer", "description": "Product ID" } },
        "required": ["id"]
      }
    },
    {
      "name": "list-orders",
      "description": "List all orders.",
      "http_method": "GET",
      "endpoint": "/orders",
      "input_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "description": "Filter by status: pending, processing, completed, cancelled" },
          "per_page": { "type": "integer", "default": 20 }
        },
        "required": []
      }
    },
    {
      "name": "get-order",
      "description": "Get details of a specific order.",
      "http_method": "GET",
      "endpoint": "/orders/{id}",
      "input_schema": {
        "type": "object",
        "properties": { "id": { "type": "integer" } },
        "required": ["id"]
      }
    },
    {
      "name": "update-order-status",
      "description": "Update the status of an order.",
      "http_method": "PUT",
      "endpoint": "/orders/{id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "status": { "type": "string", "description": "New status: pending, processing, on-hold, completed, cancelled, refunded, failed" }
        },
        "required": ["id", "status"]
      }
    },
    {
      "name": "list-customers",
      "description": "List all customers.",
      "http_method": "GET",
      "endpoint": "/customers",
      "input_schema": { "type": "object", "properties": {}, "required": [] }
    }
  ],
  "syncs": [
    { "name": "products", "description": "Sync all products from WooCommerce.", "entity": "Product", "frequency": "daily" },
    { "name": "orders", "description": "Sync orders from WooCommerce.", "entity": "Order", "frequency": "1h" },
    { "name": "customers", "description": "Sync customers from WooCommerce.", "entity": "Customer", "frequency": "daily" }
  ],
  "provider_config": {
    "display_name": "WooCommerce",
    "authorization_url": "",
    "token_url": "",
    "disable_pkce": true,
    "default_scopes": "",
    "docs": "https://woocommerce.github.io/woocommerce-rest-api-docs/",
    "setup_guide_url": "https://woocommerce.com/document/woocommerce-rest-api/",
    "webhook_routing_script": null,
    "post_connection_script": null,
    "proxy": {
      "base_url": "https://{store_url}/wp-json/wc/v3",
      "headers": { "Authorization": "Basic ${base64(consumerKey:consumerSecret)}" },
      "paginate": {
        "type": "offset",
        "limit_param": "per_page",
        "offset_param": "page"
      },
      "retry": { "error_code": ["401", "429", "5xx"] }
    },
    "authorization_params": {},
    "connection_config": {
      "store_url": {
        "type": "string",
        "title": "Store URL",
        "description": "Your WooCommerce store URL (without trailing slash)",
        "example": "mystore.com"
      }
    }
  },
  "executor": "generic_http",
  "skill_source": {
    "composio_skill_folder": "woocommerce-automation",
    "display_name": "WooCommerce Automation",
    "description": "Automate e-commerce workflows with WooCommerce including product management, order processing, and customer management.",
    "toolkit_slug": "woocommerce",
    "composio_tool_slugs": [],
    "tool_slugs_hint": []
  }
}
