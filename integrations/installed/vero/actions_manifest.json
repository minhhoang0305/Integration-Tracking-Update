{
  "provider": "vero",
  "auth_type": "api_key",
  "base_url": "https://api.verosystems.com",
  "category": "marketing",
  "stub": false,
  "actions": [
    {
      "name": "get-subscriber",
      "description": "Retrieve a specific subscriber by ID.",
      "http_method": "GET",
      "endpoint": "/subscribers/{subscriber_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "subscriber_id": {
            "type": "string",
            "description": "The ID of the subscriber."
          }
        },
        "required": [
          "subscriber_id"
        ]
      }
    },
    {
      "name": "create-subscriber",
      "description": "Create a new subscriber.",
      "http_method": "POST",
      "endpoint": "/subscribers",
      "input_schema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The email address of the subscriber."
          },
          "first_name": {
            "type": "string",
            "description": "The first name of the subscriber."
          },
          "last_name": {
            "type": "string",
            "description": "The last name of the subscriber."
          }
        },
        "required": [
          "email"
        ]
      }
    },
    {
      "name": "update-subscriber",
      "description": "Update an existing subscriber.",
      "http_method": "PUT",
      "endpoint": "/subscribers/{subscriber_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "subscriber_id": {
            "type": "string",
            "description": "The ID of the subscriber."
          },
          "first_name": {
            "type": "string",
            "description": "The first name of the subscriber."
          },
          "last_name": {
            "type": "string",
            "description": "The last name of the subscriber."
          }
        },
        "required": [
          "subscriber_id"
        ]
      }
    },
    {
      "name": "delete-subscriber",
      "description": "Delete a subscriber.",
      "http_method": "DELETE",
      "endpoint": "/subscribers/{subscriber_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "subscriber_id": {
            "type": "string",
            "description": "The ID of the subscriber."
          }
        },
        "required": [
          "subscriber_id"
        ]
      }
    },
    {
      "name": "list-subscribers",
      "description": "List all subscribers.",
      "http_method": "GET",
      "endpoint": "/subscribers",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "The maximum number of subscribers to return."
          },
          "offset": {
            "type": "integer",
            "description": "The offset to start the list from."
          }
        },
        "required": []
      }
    },
    {
      "name": "get-campaign",
      "description": "Retrieve a specific campaign by ID.",
      "http_method": "GET",
      "endpoint": "/campaigns/{campaign_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "description": "The ID of the campaign."
          }
        },
        "required": [
          "campaign_id"
        ]
      }
    },
    {
      "name": "create-campaign",
      "description": "Create a new campaign.",
      "http_method": "POST",
      "endpoint": "/campaigns",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the campaign."
          },
          "type": {
            "type": "string",
            "description": "The type of the campaign."
          }
        },
        "required": [
          "name",
          "type"
        ]
      }
    }
  ],
  "syncs": [
    {
      "name": "subscribers",
      "description": "Sync all subscribers.",
      "entity": "Subscriber",
      "frequency": "daily"
    },
    {
      "name": "campaigns",
