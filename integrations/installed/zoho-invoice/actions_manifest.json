{
  "provider": "zoho-invoice",
  "auth_type": "oauth2",
  "base_url": "https://www.zohoapis.com/invoice/v3",
  "category": "accounting",
  "stub": false,
  "actions": [
    {
      "name": "get-invoice",
      "description": "Retrieve a specific invoice by ID.",
      "http_method": "GET",
      "endpoint": "/invoices/{invoice_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string",
            "description": "The ID of the invoice to retrieve."
          }
        },
        "required": [
          "invoice_id"
        ]
      }
    },
    {
      "name": "list-invoices",
      "description": "List all invoices.",
      "http_method": "GET",
      "endpoint": "/invoices",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Page number for pagination."
          },
          "per_page": {
            "type": "integer",
            "description": "Number of invoices per page."
          }
        },
        "required": []
      }
    },
    {
      "name": "create-invoice",
      "description": "Create a new invoice.",
      "http_method": "POST",
      "endpoint": "/invoices",
      "input_schema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "The ID of the customer."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Invoice date."
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item_name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "rate": {
                  "type": "number"
                }
              },
              "required": [
                "item_name",
                "quantity",
                "rate"
              ]
            }
          }
        },
        "required": [
          "customer_id",
          "date",
          "line_items"
        ]
      }
    },
    {
      "name": "update-invoice",
      "description": "Update an existing invoice.",
      "http_method": "PUT",
      "endpoint": "/invoices/{invoice_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string",
            "description": "The ID of the invoice to update."
          },
          "customer_id": {
            "type": "string",
            "description": "The ID of the customer."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Invoice date."
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item_name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "rate": {
                  "type": "number"
                }
              },
              "required": [
                "item_name",
                "quantity",
                "rate"
              ]
            }
          }
        },
        "required": [
          "invoice_id"
        ]
      }
    },
    {
      "name": "delete-invoice",
      "description": "Delete an invoice.",
      "http_method": "DELETE",
      "endpoint": "/invoices/{invoice_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string",
            "description": "The ID of the invoice to delete."
          }
        },
        "required": [
          "invoice_id"
        ]
      }
    },
    {
      "name": "get-customer",
      "description": "Retrieve a specific customer by ID.",
      "http_method": "GET",
      "endpoint": "/customers/{customer_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "The ID of the customer to retrieve."
          }
        },
        "required": [
          "customer_id"
        ]
      }
    },
    {
      "name": "list-customers",
      "description": "List all customers.",
      "http_method": "GET",
      "endpoint": "/customers",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "per_page": { "type": "integer" }
        }
      }
    },
    { "name": "create-customer", "description": "Create a new customer.", "http_method": "POST", "endpoint": "/customers", "input_schema": { "type": "object", "properties": { "customer_name": { "type": "string" }, "email": { "type": "string" }, "phone": { "type": "string" }, "billing_address": { "type": "object" } }, "required": ["customer_name"] } },
    { "name": "update-customer", "description": "Update an existing customer.", "http_method": "PUT", "endpoint": "/customers/{customer_id}", "input_schema": { "type": "object", "properties": { "customer_id": { "type": "string" }, "customer_name": { "type": "string" }, "email": { "type": "string" }, "phone": { "type": "string" } }, "required": ["customer_id"] } },
    { "name": "delete-customer", "description": "Delete a customer.", "http_method": "DELETE", "endpoint": "/customers/{customer_id}", "input_schema": { "type": "object", "properties": { "customer_id": { "type": "string" } }, "required": ["customer_id"] } },
    { "name": "send-invoice", "description": "Send an invoice to the customer via email.", "http_method": "POST", "endpoint": "/invoices/{invoice_id}/submit", "input_schema": { "type": "object", "properties": { "invoice_id": { "type": "string" }, "send_from_org_email_id": { "type": "boolean" }, "to_mail_ids": { "type": "array" } }, "required": ["invoice_id"] } },
    { "name": "record-payment", "description": "Record a payment for an invoice.", "http_method": "POST", "endpoint": "/invoices/{invoice_id}/payments", "input_schema": { "type": "object", "properties": { "invoice_id": { "type": "string" }, "payment_mode": { "type": "string" }, "amount": { "type": "number" }, "date": { "type": "string" } }, "required": ["invoice_id", "payment_mode", "amount"] } },
    { "name": "list-estimates", "description": "List all estimates.", "http_method": "GET", "endpoint": "/estimates", "input_schema": { "type": "object", "properties": { "page": { "type": "integer" }, "per_page": { "type": "integer" }, "status": { "type": "string" } } } },
    { "name": "get-estimate", "description": "Get a specific estimate by ID.", "http_method": "GET", "endpoint": "/estimates/{estimate_id}", "input_schema": { "type": "object", "properties": { "estimate_id": { "type": "string" } }, "required": ["estimate_id"] } },
    { "name": "create-estimate", "description": "Create a new estimate.", "http_method": "POST", "endpoint": "/estimates", "input_schema": { "type": "object", "properties": { "customer_id": { "type": "string" }, "line_items": { "type": "array" }, "expiry_date": { "type": "string" } }, "required": ["customer_id"] } },
    { "name": "update-estimate", "description": "Update an existing estimate.", "http_method": "PUT", "endpoint": "/estimates/{estimate_id}", "input_schema": { "type": "object", "properties": { "estimate_id": { "type": "string" }, "customer_id": { "type": "string" }, "line_items": { "type": "array" } }, "required": ["estimate_id"] } },
    { "name": "delete-estimate", "description": "Delete an estimate.", "http_method": "DELETE", "endpoint": "/estimates/{estimate_id}", "input_schema": { "type": "object", "properties": { "estimate_id": { "type": "string" } }, "required": ["estimate_id"] } }
  ],
  "syncs": [
    {
      "name": "invoices",
      "description": "Sync all invoices.",
      "entity": "Invoice",
      "frequency": "daily"
    },
    {
      "name": "customers",
      "description": "Sync all customers.",
      "entity": "Customer",
      "frequency": "daily"
    }
  ],
  "provider_config": {
    "display_name": "Zoho Invoice",
    "authorization_url": "https://accounts.zoho.com/oauth/v2/auth",
    "token_url": "https://accounts.zoho.com/oauth/v2/token",
    "revocation_url": "https://accounts.zoho.com/oauth/v2/token/revoke",
    "disable_pkce": false,
    "default_scopes": "ZohoInvoice.full_access",
    "docs": "https://www.zoho.com/invoice/api/",
    "setup_guide_url": "https://www.zoho.com/invoice/api/docs.html",
    "webhook_routing_script": null,
    "post_connection_script": null,
    "proxy": {
      "base_url": "https://www.zohoapis.com/invoice/v3",
      "headers": {
        "authorization": "Bearer ${accessToken}"
      },
      "paginate": {
        "type": "cursor"
      },
      "retry": {
        "at": [
          "x-ratelimit-reset"
        ],
        "error_code": [
          "401",
          "403",
          "429",
          "5xx"
        ]
      }
    },
    "authorization_params": {
      "prompt": "consent",
      "access_type": "offline"
    },
    "connection_config": {
      "extension": {
        "type": "string",
        "title": "Domain Extension",
        "description": "The domain extension of your Zoho Invoice account",
        "pattern": "^[a-z.]+$",
        "prefix": "https://invoice.zoho.",
        "example": "com",
        "optional": true,
        "suffix": "/"
      }
    },
    "docs_connect": "https://connect.uplizd.ai/docs/integrations/all/zoho-invoice/connect"
  },
  "executor": "generic_http",
  "skill_source": {
    "composio_skill_folder": "zoho-invoice-automation",
    "display_name": "zoho-invoice-automation",
    "description": "Automate Zoho Invoice tasks via Rube MCP (Composio). Always search tools first for current schemas.",
    "toolkit_slug": "zoho_invoice",
    "composio_tool_slugs": [],
    "tool_slugs_hint": [
      "ACTIVE",
      "TOOL_SLUG_FROM_SEARCH"
    ]
  }
}
