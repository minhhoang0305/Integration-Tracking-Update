      "ZENDESK_CREATE_ZENDESK_TICKET",
      "ZOHO_CREATE_ZOHO_RECORD",
      "ZOHO_DESK_",
      "ZOHO_GET_ZOHO_USERS",
      "ZOHO_INVOICE_LIST_CONTACTS"
    ]
  }
}
